#!/usr/bin/env bash
# Last gate: scans every commit about to be pushed. It catches what the commit
# hooks never see, such as a cherry-pick, a rebase or a merge.
set -euo pipefail
. "$(dirname "$0")/private-words.sh"

remote="$1"
no_commit='^0+$'

# A GitHub noreply address whose login is the name, as `<id>+login@users.noreply.github.com`,
# is an identity GitHub makes public by design, so it is not scanned. Any other name or
# email is, so a personal address still blocks the push.
public_identity() {
  local name email
  name="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
  email="$(printf '%s' "$2" | tr '[:upper:]' '[:lower:]')"
  [[ "$email" =~ ^([0-9]+\+)?([a-z0-9-]+)@users\.noreply\.github\.com$ ]] && [ "${BASH_REMATCH[2]}" = "$name" ]
}

identities() {
  local an ae cn ce
  { IFS= read -r an; IFS= read -r ae; IFS= read -r cn; IFS= read -r ce; } < <(git log -1 --format='%an%n%ae%n%cn%n%ce' "$1")
  public_identity "$an" "$ae" || printf '%s\n%s\n' "$an" "$ae"
  public_identity "$cn" "$ce" || printf '%s\n%s\n' "$cn" "$ce"
}

scan_commit() {
  {
    git log -1 --format='%B' "$1"
    identities "$1"
    git diff-tree --root -m -r --no-commit-id --name-only --no-renames --diff-filter=d -z "$1" | tr '\0' '\n'
    git diff-tree --root -m -r --no-commit-id -p -U0 --text --no-color --no-ext-diff --no-textconv --no-renames "$1" | added_lines
  } | scan_private
}

while read -r _ local_sha _ remote_sha; do
  [[ ! "$local_sha" =~ $no_commit ]] || continue
  if [[ "$remote_sha" =~ $no_commit ]] || ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    commits="$(git rev-list "$local_sha" --not --remotes="$remote")"
  else
    commits="$(git rev-list "$remote_sha..$local_sha")"
  fi
  for commit in $commits; do
    hits="$(scan_commit "$commit")"
    [ -z "$hits" ] || blocked "Push of $commit" "$hits"
  done
done
