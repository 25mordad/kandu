#!/usr/bin/env bash
# Opens Claude Code in the Didban role. Symlink this into your PATH.
set -euo pipefail

repo="$(dirname "$(dirname "$(readlink -f "$0")")")"
export PATH="$repo/meter:$HOME/.local/bin:$PATH" GH_METER_CALLER=didban  # each gh call is counted
cd "$repo"
exec .venv/bin/python -m kandu.didban "$@"
