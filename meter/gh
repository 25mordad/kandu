#!/usr/bin/env bash
# Counts one `gh` call in state/gh/<day>.jsonl, then runs the real `gh` (docs/STATE.md).
# Only the caller, the run, the call's id and the first two words are kept: never a body, a query or a token.
# It also keeps GitHub's back-off (state/gh/backoff.json, kandu/ghlimit.py) for every caller, agents too:
# while one is in force it waits until then before calling, and a rate-limit answer starts one.
here="$(dirname "$(readlink -f "$0")")"
real=""
IFS=: read -ra dirs <<< "$PATH"
for dir in "${dirs[@]}"; do
  [ -n "$dir" ] && [ -x "$dir/gh" ] || continue
  [ "$(readlink -f "$dir/gh")" = "$here/gh" ] && continue
  real="$dir/gh"
  break
done
if [ -z "$real" ]; then
  echo "gh: the real gh is not on PATH" >&2
  exit 127
fi

log="${GH_METER_LOG:-$(dirname "$here")/state/gh}"
backoff="$log/backoff.json"
# Kandu's own calls keep the back-off themselves (kandu/github.py); `gh api rate_limit` costs nothing and is how
# the wait is found, so it never waits.
gated=1
[ -n "${GH_METER_GATE:-}" ] && gated=""
[ "${1:-}" = api ] && [ "${2:-}" = rate_limit ] && gated=""

if [ -n "$gated" ]; then
  until="$(sed -n 's/.*"until": *\([0-9][0-9]*\).*/\1/p' "$backoff" 2>/dev/null | head -n 1)"
  now="$(date +%s)"
  if [ -n "$until" ] && [ "$until" -gt "$now" ]; then
    echo "gh: GitHub's rate limit: waiting until $(date -d "@$until" +%T) before calling" >&2
    sleep "$((until - now))"
  fi
  err="$(mktemp)"
  "$real" "$@" 2> >(tee "$err" >&2)
  code=$?
  wait $! 2>/dev/null
  if [ "$code" -eq 0 ]; then
    rm -f "$backoff"
  else
    root="$(dirname "$here")"
    python="$root/.venv/bin/python"
    [ -x "$python" ] || python=python3
    PYTHONPATH="$root" "$python" -m kandu.ghlimit refused "$backoff" < "$err" >/dev/null 2>&1
  fi
  rm -f "$err"
else
  "$real" "$@"
  code=$?
fi

word() { printf '%s' "${1//[^a-z-]/}"; }
first="$(word "${1:-}")"
case "$first" in
  api) [ "${2:-}" = graphql ] && command="api graphql" || command="api rest" ;;
  *) command="$first $(word "${2:-}")" ;;
esac
case "$first" in
  api) [ "${2:-}" = graphql ] && kind=graphql || kind=rest ;;
  run|release|workflow|secret|variable|cache|gist|ssh-key|gpg-key|auth|attestation|extension|alias|config|ruleset) kind=rest ;;
  *) kind=graphql ;;
esac
caller="${GH_METER_CALLER:-other}"
run="${GH_METER_RUN:-}"
call="${GH_METER_CALL:-}"
{
  mkdir -p -m 700 "$log" &&
  printf '{"v": 1, "ts": "%s", "type": "call", "caller": "%s", "run": "%s", "call": "%s", "command": "%s", "kind": "%s", "exit": %d}\n' \
    "$(date -Iseconds)" "${caller//[^A-Za-z0-9:_.-]/}" "${run//[^A-Za-z0-9:_.-]/}" "${call//[^A-Za-z0-9:_.-]/}" "${command% }" "$kind" "$code" \
    >> "$log/$(date +%F).jsonl"
} 2>/dev/null
exit $code
