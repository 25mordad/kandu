#!/usr/bin/env bash
# Blocks a commit whose added lines or file names contain a private term.
# Enable once per clone: git config core.hooksPath .githooks
set -euo pipefail
. "$(dirname "$0")/private-words.sh"

hits="$(
  {
    git diff --cached --name-only --no-renames --diff-filter=d -z | tr '\0' '\n'
    git diff --cached -U0 --text --no-color --no-ext-diff --no-textconv --no-renames | added_lines
  } | scan_private
)"

[ -z "$hits" ] || blocked "Commit" "$hits"
